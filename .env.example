# Claude API (required for the LLM layer; run with --no-llm otherwise)
ANTHROPIC_API_KEY=
# Only for org-level keys NOT scoped to a workspace (400 'not scoped to a workspace'): Console > Workspaces > ID
ANTHROPIC_WORKSPACE_ID=
# DART OpenAPI key (optional; https://opendart.fss.or.kr) - improves KR filings coverage
DART_API_KEY=
# SEC EDGAR requires a descriptive User-Agent: "Org Name contact@yourdomain.com"
SEC_USER_AGENT=
# Optional: job-posting forward ledger (quantcio alt jobs). Saramin: https://oapi.saramin.co.kr/ ; Work24: corporate members only
SARAMIN_API_KEY=
WORK24_API_KEY=
# Optional: data.go.kr key (the NPS workplace files download without it)
DATA_GO_KR_KEY=

# ---- 추가 무료 키(연구용, scripts/api_keys.py · scripts/keyed_study.py) — 넣기만 하면 자동으로 쓰입니다 ----
# 확인: .venv/bin/python scripts/api_keys.py   수집: ... api_keys.py fetch   매일 기록: ... api_keys.py ledger
# 미국 특허청 오픈데이터(특허): https://data.uspto.gov/apikey (USPTO.gov 계정 + ID.me 본인 인증)
USPTO_API_KEY=
# FRED(실업수당 청구·금융여건·소비자심리 최초 발표값, 2년 금리): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# BLS v2(JOLTS 업종별 채용·퇴사·구인): https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# EIA(천연가스 저장량): https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Finnhub(애널리스트 추천·뉴스 건수, 오늘부터 기록): https://finnhub.io/register
FINNHUB_API_KEY=
# 한국은행 ECOS(기준금리·물가·경제심리·소비자심리·업종별 기업경기전망): https://ecos.bok.or.kr/api/#/AuthKeyApply
ECOS_API_KEY=
# 통계청 KOSIS(사업체노동력조사 산업별 입직·이직률): https://kosis.kr/openapi/
KOSIS_API_KEY=
# 특허정보원 KIPRIS Plus(회사별 특허 등록 수): https://plus.kipris.or.kr
KIPRIS_API_KEY=
# 네이버 검색 API(회사별 뉴스 건수, 오늘부터 기록): https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 레딧 API(종목 언급·강세/약세 단어, 오늘부터 기록): 2025-11부터 사전 승인제 — support.reddithelp.com에서 Data API
# 접근 요청 → 승인 메일 후 https://www.reddit.com/prefs/apps 에서 'script' 앱 생성(없어도 ApeWisdom이 레딧 언급 수를 기록)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# KRX 정보데이터시스템 계정(종목별 연기금 등 순매수, 시장 프로그램매매 — docs/MODELING.md 31): https://data.krx.co.kr 무료 회원가입
KRX_ID=
KRX_PW=
# 미국 인구조사국 API(초혼 연령 ACS B12007): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# KRX 아이디 로그인이 안 되는 계정(구글 가입 등): 브라우저 로그인 후 개발자도구 → Application → Cookies → data.krx.co.kr 의 JSESSIONID 값
KRX_JSESSIONID=
# 영화진흥위원회 KOBIS 오픈API(한국 일별 박스오피스, docs/MODELING.md 69): https://www.kobis.or.kr/kobisopenapi 회원가입 → 키 발급
KOBIS_API_KEY=
# 도서관 정보나루(한국 인기 대출 도서, 69): https://www.data4library.kr 회원가입 → 인증키 신청(승인 후 사용)
LIBRARY_API_KEY=
# 뉴욕타임스 Books API(미국 주간 베스트셀러, 69): https://developer.nytimes.com 앱 만들기 → Books API 켜기
NYT_API_KEY=
# YouTube Data API v3(한국·미국 인기 동영상, 오늘부터 매일 기록, 69): Google Cloud 콘솔 → API 사용 설정 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=
# 조달청 나라장터 공사 계약(69)은 위 DATA_GO_KR_KEY로 받습니다 — data.go.kr에서 "조달청_나라장터 계약정보서비스" 활용신청 필요
